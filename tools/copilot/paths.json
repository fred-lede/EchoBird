{
    "name": "GitHub Copilot CLI",
    "category": "CLI Code",
    "apiProtocol": ["openai", "anthropic"],
    "docs": "https://docs.github.com/en/copilot/how-tos/copilot-cli",
    "website": "https://github.com/github/copilot-cli",
    "command": "copilot",
    "startCommand": "copilot",
    "envVar": "COPILOT_CLI_PATH",
    "configDir": "~/.copilot",
    "configFile": "~/.copilot/providers.json",
    "requireConfigFile": false,
    "paths": {
        "win32": [
            "%APPDATA%\\npm\\copilot.cmd",
            "%LOCALAPPDATA%\\Microsoft\\WinGet\\Links\\copilot.exe",
            "%USERPROFILE%\\.local\\bin\\copilot.exe",
            "%USERPROFILE%\\scoop\\shims\\copilot.exe",
            "%USERPROFILE%\\.bun\\bin\\copilot.exe",
            "%LOCALAPPDATA%\\pnpm\\copilot.cmd"
        ],
        "darwin": [
            "/opt/homebrew/bin/copilot",
            "/usr/local/bin/copilot",
            "~/.local/bin/copilot",
            "~/.npm-global/bin/copilot",
            "~/.bun/bin/copilot",
            "~/Library/pnpm/copilot"
        ],
        "linux": [
            "/usr/local/bin/copilot",
            "/usr/bin/copilot",
            "~/.local/bin/copilot",
            "~/.npm-global/bin/copilot",
            "~/.bun/bin/copilot",
            "~/.local/share/pnpm/copilot"
        ]
    }
}
