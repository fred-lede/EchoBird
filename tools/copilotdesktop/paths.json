{
    "name": "GitHub Copilot",
    "names": {
        "zh-Hans": "GitHub Copilot 桌面端",
        "zh-Hant": "GitHub Copilot 桌面端"
    },
    "category": "Desktop",
    "apiProtocol": ["openai", "anthropic"],
    "docs": "https://docs.github.com/en/copilot/concepts/copilot-surfaces/github-copilot-app",
    "website": "https://github.com/github/app",
    "command": "",
    "configDir": "~/.copilot",
    "configFile": "~/.copilot/data.db",
    "requireConfigFile": false,
    "paths": {
        "win32": ["%LOCALAPPDATA%\\Programs\\GitHub Copilot\\github.exe"],
        "darwin": [
            "/Applications/GitHub Copilot.app",
            "~/Applications/GitHub Copilot.app"
        ],
        "linux": [
            "~/Applications/GitHub-Copilot-linux-x64.AppImage",
            "~/Applications/GitHub-Copilot-linux-arm64.AppImage"
        ]
    },
    "installHints": {
        "windowsDisplayNames": ["GitHub Copilot"],
        "macosAppName": "GitHub Copilot",
        "linuxDesktopNames": ["GitHub Copilot", "github-copilot"]
    }
}
