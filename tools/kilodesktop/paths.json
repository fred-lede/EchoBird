{
    "name": "Kilo Desktop",
    "names": {"zh-Hans": "Kilo 桌面端"},
    "category": "Desktop",
    "apiProtocol": ["openai"],
    "docs": "https://kilo.ai/docs/desktop",
    "website": "https://kilo.ai/install",
    "command": "",
    "configDir": "~/.config/kilo",
    "configFile": "~/.config/kilo/kilo.json",
    "requireConfigFile": false,
    "paths": {
        "win32": ["%LOCALAPPDATA%\\KiloDesktop\\kilo-desktop.exe", "%LOCALAPPDATA%\\KiloDesktop"],
        "darwin": ["/Applications/Kilo.app", "~/Applications/Kilo.app"],
        "linux": ["/usr/bin/kilo-desktop", "/opt/Kilo/kilo-desktop", "/opt/kilo-desktop/kilo-desktop", "~/.local/bin/kilo-desktop"]
    },
    "processNames": {"win32": ["kilo-desktop.exe"], "darwin": ["kilo-desktop"], "linux": ["kilo-desktop"]},
    "installHints": {
        "windowsDisplayNamePrefixes": ["Kilo"],
        "windowsPublisher": "Anaconda",
        "macosAppName": "Kilo",
        "linuxDesktopNames": ["Kilo", "kilo-desktop", "ai.kilo.desktop"]
    }
}
