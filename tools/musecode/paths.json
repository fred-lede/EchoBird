{
    "name": "Muse Code",
    "category": "CLI Code",
    "apiProtocol": [
        "openai"
    ],
    "docs": "https://dev.meta.ai/docs/overview",
    "website": "https://dev.meta.ai/",
    "command": "muse",
    "startCommand": "muse",
    "configDir": "~/.config/muse",
    "configFile": "~/.config/muse/settings.json",
    "requireConfigFile": false,
    "detectByConfigDir": false,
    "paths": {
        "win32": [
            "%LOCALAPPDATA%\\Programs\\muse\\muse.cmd"
        ],
        "darwin": [
            "~/.local/bin/muse"
        ],
        "linux": [
            "~/.local/bin/muse"
        ]
    }
}
